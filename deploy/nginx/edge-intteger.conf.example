#     server {
#         listen 8989;
#         proxy_pass janus_wss;
#         proxy_connect_timeout 10s;
#     }
#
#     # Fallback: https://remote-dev-mdm.intteger.uk:8089/janus
#     server {
#         listen 8089;
#         proxy_pass janus_https;
#         proxy_connect_timeout 10s;
#     }
# }
#
# Open on edge firewall: 443, 80, 8989, 8089, 31000/tcp
# Open on fleet-vm from edge IP: 8080, 9443, 8989, 8089, 31000/tcp + UDP 10000-10500
