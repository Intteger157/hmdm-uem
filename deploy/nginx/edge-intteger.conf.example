# Edge nginx on the PUBLIC proxy server (Layout B — intteger.uk)
#
# DNS A records → THIS server's public IP (94.143.43.204):
#   test-dev-mdm.intteger.uk   → MDM console + API
#   remote-dev-mdm.intteger.uk → aPuppet remote viewer
#
# Backend (same LAN host fleet-vm):
#   192.168.31.247:8080  MDM Docker gateway
#   192.168.31.247:9443  Remote control nginx (HTTP)
#   192.168.31.247:8989  Janus WebSocket (WSS) — required for viewer
#   192.168.31.247:8089  Janus REST HTTPS — fallback in web-admin
#   192.168.31.247:31000 MQTT push (stream block below)
#
# On fleet-vm firewall: allow THIS proxy IP → ports above + UDP 10000-10500
#
# Install on PROXY:
#   sudo apt install -y nginx certbot
#   sudo mkdir -p /var/www/certbot
#   sudo cp deploy/nginx/edge-intteger.conf.example /etc/nginx/sites-available/intteger-mdm.conf
#   sudo ln -sf /etc/nginx/sites-available/intteger-mdm.conf /etc/nginx/sites-enabled/
#   # Add stream {} block from bottom into /etc/nginx/nginx.conf (outside http {})
#   sudo nginx -t && sudo systemctl reload nginx
#
# Certificates (on PROXY, port 80 must serve ACME for both domains):
#   sudo certbot certonly --webroot -w /var/www/certbot \
#     -d test-dev-mdm.intteger.uk \
#     -d remote-dev-mdm.intteger.uk \
#     --email admin@intteger.uk --agree-tos --no-eff-email
#
# Or separate certs if MDM cert already exists:
#   sudo certbot certonly --webroot -w /var/www/certbot \
#     -d remote-dev-mdm.intteger.uk \
#     --email admin@intteger.uk --agree-tos --no-eff-email

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream hmdm_gateway {
    server 192.168.31.247:8080;
    keepalive 32;
}

upstream hmdm_remote {
    server 192.168.31.247:9443;
    keepalive 8;
}

# --- HTTP → HTTPS + ACME (both domains) ---
server {
    listen 80;
    listen [::]:80;
    server_name test-dev-mdm.intteger.uk remote-dev-mdm.intteger.uk;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- MDM console + REST API ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name test-dev-mdm.intteger.uk;

    ssl_certificate     /etc/letsencrypt/live/test-dev-mdm.intteger.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test-dev-mdm.intteger.uk/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 256m;

    location / {
        proxy_pass http://hmdm_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection        "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# --- Remote control viewer (aPuppet web-admin + /janus on backend nginx) ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name remote-dev-mdm.intteger.uk;

    ssl_certificate     /etc/letsencrypt/live/remote-dev-mdm.intteger.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/remote-dev-mdm.intteger.uk/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 64m;

    location / {
        proxy_pass http://hmdm_remote;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

