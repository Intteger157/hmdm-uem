# PostgreSQL (shared by Java MDM and Go server-windows)
SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=hmdm

# Headwind MDM container settings
#
# REQUIRED before the first `./deploy/install.sh` (or first `docker compose up`):
#   BASE_DOMAIN = public hostname phones and QR codes use (NOT localhost)
#   PROTOCOL    = http when TLS terminates on a SEPARATE edge nginx (layout B)
#                 https only when certbot/Let's Encrypt runs ON THIS MDM host (layout A)
#   PUBLIC_PROTOCOL = optional override for QR/base.url (default: https if PROTOCOL=http + public domain)
#   LOCAL_IP    = LAN IP of this MDM host (optional; used to fix stale APK URLs)
#
# Local dev on localhost only: ./deploy/install.sh --dev
ADMIN_EMAIL=admin@localhost
BASE_DOMAIN=
LOCAL_IP=
# Keep false when using custom ROOT.war from deploy/install.sh
FORCE_RECONFIGURE=false
PROTOCOL=http
SHARED_SECRET=changeme-dev-secret
HMDM_VARIANT=os
DOWNLOAD_CREDENTIALS=
# Required by the hmdm entrypoint script (even when ROOT.war is mounted from this repo).
HMDM_URL=https://h-mdm.com/files/hmdm-5.39.2-os.war
CLIENT_VERSION=6.36

# Public HTTP entrypoint (nginx gateway → frontend-v2 + /rest API + /rest/windows)
GATEWAY_PORT=8080

# Go Windows MDM service
SERVER_WINDOWS_PORT=8082
GIN_MODE=release
# Public URL for uploaded app installers (e.g. https://mdm.example.com). When empty, server derives from request host.
PUBLIC_BASE_URL=
# Preferred scheme when building upload URLs behind TLS-terminating proxy (default in compose: https)
PUBLIC_PROTOCOL=https
# Persistent directory for uploaded Windows installers (mounted in docker-compose)
APPS_UPLOAD_DIR=/opt/hmdm/files/apps
# Shared with Java MDM container at ./volumes/files (MSI installers for Windows enrollment)
FILES_DIR=/opt/hmdm/files

# Autopilot bootstrap: default local admin credentials (overridable in Enrollment UI)
AUTOPILOT_ADMIN_USER=Admin
AUTOPILOT_ADMIN_PASS=

# Autopilot bootstrap: default enrollment secret (overridable in Enrollment UI Security Settings)
ENROLLMENT_SECRET=

# Console API authentication (REQUIRED).
# Must match Java jwt.secretkey in deploy/volumes/hmdm-config/ROOT.xml (Tomcat context).
# build.properties inside ROOT.war is not used at runtime. Run after install:
#   deploy/scripts/sync-jwt-secret.sh
# Leaving it empty makes every /rest/windows admin route answer 503.
JWT_SECRET=20c68f0d9185b1d18cf6add1e8b491fd89529a44

# Headwind Remote / aPuppet (optional — Android remote control)
#
# The Java deviceremote plugin stores serverUrl + serverSecret in PostgreSQL
# (plugin_deviceremote_settings), not in Tomcat env vars. After setting these,
# run: ./deploy/scripts/sync-deviceremote-settings.sh
#
# Install the remote server stack on the Linux host (Janus uses host networking):
#   git submodule update --init plugins/deviceremote/h-mdm-remote-control
#   sudo ./deploy/scripts/install-remote-control.sh
#
# See deploy/REMOTE-CONTROL.md for firewall ports, single-port HAProxy, and Android agent.
# Put comments on their own line — inline "KEY=value  # comment" is not supported.
REMOTE_DOMAIN=
REMOTE_SERVER_URL=
REMOTE_SERVER_SECRET=
# Let's Encrypt contact (email address, not a domain)
REMOTE_CERTBOT_EMAIL=
REMOTE_HTTPS_PORT=9443
REMOTE_HTTP_LISTEN=127.0.0.1:8080
REMOTE_PUBLIC_IP=
REMOTE_NAT=true
REMOTE_CUSTOMER_ID=1
